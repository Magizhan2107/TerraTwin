{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terratwin:earth-thermal-availability-report:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "dataset_id",
    "catalog_sha256",
    "config_sha256",
    "source_product_version",
    "export_files",
    "processing_script_sha256",
    "threshold_status",
    "phase_windows_hours",
    "exploratory_monthly_thresholds",
    "received_partitions",
    "expected_partitions",
    "raw_swath_observation_count",
    "effective_independent_observation_count",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "earth-thermal-availability-report/1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_id": {
      "const": "MODIS/061/MYD11A1"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_product_version": {
      "const": "061"
    },
    "export_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "sha256"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "processing_script_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "common.py",
        "reporting.py",
        "ee_export.py"
      ],
      "properties": {
        "common.py": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reporting.py": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ee_export.py": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "threshold_status": {
      "const": "provisional_diagnostic_only"
    },
    "phase_windows_hours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "night"
      ],
      "properties": {
        "day": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          }
        },
        "night": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          }
        }
      }
    },
    "exploratory_monthly_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strict_qa_phase_dates_min",
        "strict_qa_phase_date_fraction_min",
        "same_product_date_spatial_support_fraction_min"
      ],
      "properties": {
        "strict_qa_phase_dates_min": {
          "type": "integer",
          "minimum": 0
        },
        "strict_qa_phase_date_fraction_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "same_product_date_spatial_support_fraction_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "received_partitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "expected_partitions": {
      "const": 30
    },
    "raw_swath_observation_count": {
      "type": "null"
    },
    "effective_independent_observation_count": {
      "type": "null"
    },
    "records": {
      "type": "array",
      "minItems": 390,
      "maxItems": 390,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lst_valid",
        "qc_present",
        "mandatory_produced",
        "mandatory_good",
        "data_quality_good",
        "emissivity_error_le_0_01",
        "lst_error_le_1k",
        "time_valid",
        "phase_window",
        "strict_qa",
        "relaxed_qa",
        "strict_qa_in_phase",
        "relaxed_qa_in_phase",
        "strict_qa_with_time",
        "relaxed_qa_with_time"
      ],
      "properties": {
        "lst_valid": {
          "type": "integer",
          "minimum": 0
        },
        "qc_present": {
          "type": "integer",
          "minimum": 0
        },
        "mandatory_produced": {
          "type": "integer",
          "minimum": 0
        },
        "mandatory_good": {
          "type": "integer",
          "minimum": 0
        },
        "data_quality_good": {
          "type": "integer",
          "minimum": 0
        },
        "emissivity_error_le_0_01": {
          "type": "integer",
          "minimum": 0
        },
        "lst_error_le_1k": {
          "type": "integer",
          "minimum": 0
        },
        "time_valid": {
          "type": "integer",
          "minimum": 0
        },
        "phase_window": {
          "type": "integer",
          "minimum": 0
        },
        "strict_qa": {
          "type": "integer",
          "minimum": 0
        },
        "relaxed_qa": {
          "type": "integer",
          "minimum": 0
        },
        "strict_qa_in_phase": {
          "type": "integer",
          "minimum": 0
        },
        "relaxed_qa_in_phase": {
          "type": "integer",
          "minimum": 0
        },
        "strict_qa_with_time": {
          "type": "integer",
          "minimum": 0
        },
        "relaxed_qa_with_time": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pixel_retrieval_counts",
        "distinct_product_dates",
        "qa_histograms",
        "observation_time_raw_dn_histogram",
        "circular_mean_local_solar_hour",
        "zero_time_with_valid_lst_count",
        "dates_with_strict_phase_support_at_threshold",
        "strict_qa_observation_time_raw_dn_histogram",
        "relaxed_qa_observation_time_raw_dn_histogram",
        "calendar_date_coverage_fraction",
        "strict_phase_supported_calendar_date_fraction"
      ],
      "properties": {
        "pixel_retrieval_counts": {
          "$ref": "#/$defs/counts"
        },
        "distinct_product_dates": {
          "$ref": "#/$defs/counts"
        },
        "qa_histograms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mandatory",
            "data_quality",
            "emissivity_error",
            "lst_error"
          ],
          "properties": {
            "mandatory": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "0",
                "1",
                "2",
                "3"
              ],
              "properties": {
                "0": {
                  "type": "integer",
                  "minimum": 0
                },
                "1": {
                  "type": "integer",
                  "minimum": 0
                },
                "2": {
                  "type": "integer",
                  "minimum": 0
                },
                "3": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "data_quality": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "0",
                "1",
                "2",
                "3"
              ],
              "properties": {
                "0": {
                  "type": "integer",
                  "minimum": 0
                },
                "1": {
                  "type": "integer",
                  "minimum": 0
                },
                "2": {
                  "type": "integer",
                  "minimum": 0
                },
                "3": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "emissivity_error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "0",
                "1",
                "2",
                "3"
              ],
              "properties": {
                "0": {
                  "type": "integer",
                  "minimum": 0
                },
                "1": {
                  "type": "integer",
                  "minimum": 0
                },
                "2": {
                  "type": "integer",
                  "minimum": 0
                },
                "3": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "lst_error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "0",
                "1",
                "2",
                "3"
              ],
              "properties": {
                "0": {
                  "type": "integer",
                  "minimum": 0
                },
                "1": {
                  "type": "integer",
                  "minimum": 0
                },
                "2": {
                  "type": "integer",
                  "minimum": 0
                },
                "3": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "observation_time_raw_dn_histogram": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-3][0-9]|240)$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "circular_mean_local_solar_hour": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 24
        },
        "zero_time_with_valid_lst_count": {
          "type": "integer",
          "minimum": 0
        },
        "dates_with_strict_phase_support_at_threshold": {
          "type": "integer",
          "minimum": 0
        },
        "strict_qa_observation_time_raw_dn_histogram": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-3][0-9]|240)$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "relaxed_qa_observation_time_raw_dn_histogram": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-3][0-9]|240)$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "calendar_date_coverage_fraction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lst_valid",
            "qc_present",
            "mandatory_produced",
            "mandatory_good",
            "data_quality_good",
            "emissivity_error_le_0_01",
            "lst_error_le_1k",
            "time_valid",
            "phase_window",
            "strict_qa",
            "relaxed_qa",
            "strict_qa_in_phase",
            "relaxed_qa_in_phase",
            "strict_qa_with_time",
            "relaxed_qa_with_time"
          ],
          "properties": {
            "lst_valid": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "qc_present": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "mandatory_produced": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "mandatory_good": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "data_quality_good": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "emissivity_error_le_0_01": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "lst_error_le_1k": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "time_valid": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "phase_window": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "strict_qa": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "relaxed_qa": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "strict_qa_in_phase": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "relaxed_qa_in_phase": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "strict_qa_with_time": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "relaxed_qa_with_time": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "strict_phase_supported_calendar_date_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pixel_retrieval_count",
        "distinct_product_dates",
        "dates_at_spatial_support_threshold",
        "mean_spatial_support_fraction_over_calendar_dates"
      ],
      "properties": {
        "pixel_retrieval_count": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_product_dates": {
          "type": "integer",
          "minimum": 0
        },
        "dates_at_spatial_support_threshold": {
          "type": "integer",
          "minimum": 0
        },
        "mean_spatial_support_fraction_over_calendar_dates": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_id",
        "name",
        "canonical_latitude",
        "canonical_longitude",
        "period_type",
        "period",
        "expected_product_dates",
        "input_status",
        "source_product_dates",
        "missing_product_dates",
        "native_center_count",
        "requested_footprint_area_m2",
        "sampled_center_area_m2",
        "phases",
        "same_product_date_joint_strict_phase",
        "exploratory_screen",
        "source_product_date_fraction"
      ],
      "properties": {
        "location_id": {
          "type": "string",
          "enum": [
            "24",
            "73",
            "122",
            "220",
            "269",
            "318",
            "367",
            "465",
            "661",
            "710"
          ]
        },
        "name": {
          "type": "string"
        },
        "canonical_latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "canonical_longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "period_type": {
          "enum": [
            "month",
            "year"
          ]
        },
        "period": {
          "type": "string",
          "pattern": "^202[1-3](?:-(?:0[1-9]|1[0-2]))?$"
        },
        "expected_product_dates": {
          "type": "integer",
          "minimum": 28,
          "maximum": 366
        },
        "input_status": {
          "enum": [
            "complete",
            "pending_export"
          ]
        },
        "source_product_dates": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "missing_product_dates": {
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "native_center_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "requested_footprint_area_m2": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "sampled_center_area_m2": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "phases": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "day",
                "night"
              ],
              "properties": {
                "day": {
                  "$ref": "#/$defs/phase"
                },
                "night": {
                  "$ref": "#/$defs/phase"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "same_product_date_joint_strict_phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/joint"
            },
            {
              "type": "null"
            }
          ]
        },
        "exploratory_screen": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_evaluated",
                "meets_exploratory_screen",
                "below_exploratory_screen"
              ]
            },
            "reason_codes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "source_product_date_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "input_status": {
                "const": "pending_export"
              }
            }
          },
          "then": {
            "properties": {
              "source_product_dates": {
                "type": "null"
              },
              "missing_product_dates": {
                "type": "null"
              },
              "native_center_count": {
                "type": "null"
              },
              "requested_footprint_area_m2": {
                "type": "null"
              },
              "sampled_center_area_m2": {
                "type": "null"
              },
              "phases": {
                "type": "null"
              },
              "same_product_date_joint_strict_phase": {
                "type": "null"
              },
              "source_product_date_fraction": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "source_product_dates": {
                "type": "integer",
                "minimum": 0
              },
              "missing_product_dates": {
                "type": "array"
              },
              "native_center_count": {
                "type": "integer",
                "minimum": 1
              },
              "requested_footprint_area_m2": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "phases": {
                "type": "object"
              },
              "same_product_date_joint_strict_phase": {
                "type": "object"
              },
              "source_product_date_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "period_type": {
                "const": "year"
              }
            }
          },
          "then": {
            "properties": {
              "period": {
                "pattern": "^202[1-3]$"
              }
            }
          },
          "else": {
            "properties": {
              "period": {
                "pattern": "^202[1-3]-(?:0[1-9]|1[0-2])$"
              }
            }
          }
        }
      ]
    }
  }
}
